{
  "name": "assessment-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "test": "npm test -w server",
    "db:migrate": "npm run db:migrate -w server",
    "setup": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "effect": "3.22.5",
    "deepmerge-ts": "8.0.2"
  },
  "dependencies": {
    "prisma": "6.19.0"
  }
}
