NODE_ENV=development
PORT=4000
DATABASE_URL=file:./dev.db
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_ORIGIN=http://localhost:5173
# Required to claim disujt@gmail.com on signup; use a different random secret.
ADMIN_REGISTRATION_SECRET=replace-with-a-separate-random-secret
# Set true only behind one trusted reverse proxy (Render).
TRUST_PROXY=false
# Production cross-site frontend/backend: none; local development: lax.
COOKIE_SAME_SITE=lax
