generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("TAKER")
  disabled     Boolean  @default(false)
  createdAt    DateTime @default(now())
  attempts     TestAttempt[]
}
model Test {
  id           String   @id @default(cuid())
  title        String
  description  String
  duration     Int
  published    Boolean  @default(false)
  deleted      Boolean  @default(false)
  multipleAttempts Boolean @default(false)
  passMark     Float?
  startsAt     DateTime?
  endsAt       DateTime?
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  questions    Question[]
  attempts     TestAttempt[]
  @@index([published, deleted])
}
model Question {
  id           String @id @default(cuid())
  testId       String
  test         Test @relation(fields:[testId], references:[id], onDelete:Cascade)
  position     Int
  prompt       String
  type         String
  points       Float
  correct      Json
  guidelines   String
  caseSensitive Boolean @default(false)
  options      QuestionOption[]
  @@unique([testId, position])
}
model QuestionOption {
  id         String @id @default(cuid())
  questionId String
  question   Question @relation(fields:[questionId], references:[id], onDelete:Cascade)
  key        String
  text       String
  @@unique([questionId, key])
}
model TestAttempt {
  id          String @id @default(cuid())
  userId      String
  user        User @relation(fields:[userId], references:[id], onDelete:Restrict)
  testId      String
  test        Test @relation(fields:[testId], references:[id], onDelete:Restrict)
  number      Int
  snapshot    Json
  startedAt   DateTime @default(now())
  deadline    DateTime
  submittedAt DateTime?
  expired     Boolean @default(false)
  status      String @default("IN_PROGRESS")
  answers     Answer[]
  grade       Grade?
  feedback    Feedback?
  @@unique([userId, testId, number])
  @@index([status, deadline])
  @@index([userId, startedAt])
  @@index([testId, status])
}
model Answer {
  id          String @id @default(cuid())
  attemptId   String
  attempt     TestAttempt @relation(fields:[attemptId], references:[id], onDelete:Cascade)
  questionId  String
  value       Json
  score       Float?
  comment     String @default("")
  updatedAt   DateTime @updatedAt
  @@unique([attemptId, questionId])
}
model Grade {
  id          String @id @default(cuid())
  attemptId   String @unique
  attempt     TestAttempt @relation(fields:[attemptId], references:[id], onDelete:Cascade)
  status      String @default("PENDING")
  total       Float
  score       Float
  released    Boolean @default(false)
  releasedAt  DateTime?
  updatedAt   DateTime @updatedAt
}
model Feedback {
  id          String @id @default(cuid())
  attemptId   String @unique
  attempt     TestAttempt @relation(fields:[attemptId], references:[id], onDelete:Cascade)
  text        String
  updatedAt   DateTime @updatedAt
}
